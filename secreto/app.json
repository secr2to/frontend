{
  "expo": {
    "name": "secreto",
    "slug": "secreto",
    "version": "0.0.1",
    "orientation": "portrait",
    "image": "./shared/images/splash-icon.png",
    "scheme": "secreto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./shared/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./shared/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./shared/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앱이 친구들과 사진을 공유할 수 있도록 사진에 접근합니다.",
          "cameraPermission": "앱이 친구들과 사진을 공유할 수 있도록 카메라에 접근합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
